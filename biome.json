{
  "$schema": "https://biomejs.dev/schemas/2.3.3/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "includes": [
      "**/apps/**/*.css",
      "**/apps/**/*.js",
      "**/apps/**/*.jsx",
      "**/apps/**/*.json",
      "**/apps/**/*.md",
      "**/apps/**/*.ts",
      "**/apps/**/*.tsx",
      "**/packages/**/*.css",
      "**/packages/**/*.js",
      "**/packages/**/*.jsx",
      "**/packages/**/*.json",
      "**/packages/**/*.md",
      "**/packages/**/*.ts",
      "**/packages/**/*.tsx",
      "**/*.js",
      "**/*.json",
      "**/*.ts",
      "!**/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "enabled": true,
      "quoteStyle": "single"
    },
    "globals": ["BufferEncoding"]
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUndeclaredDependencies": "off"
      },
      "style": {
        "useNamingConvention": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/apps/server/**/*.ts",
        "**/apps/server/**/*.tsx",
        "**/apps/timetable-parser-service/**/*.ts",
        "**/apps/timetable-parser-service/**/*.tsx",
        "**/apps/ui/tsconfig.node.json",
        "**/packages/**/*.ts",
        "**/packages/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["**/apps/ui/**/*.ts", "**/apps/ui/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noReactSpecificProps": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "master",
    "enabled": true,
    "useIgnoreFile": true
  }
}
